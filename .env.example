# KASHTA environment variables. Copy to .env.local for local development and add the same
# keys in your hosting provider's settings. Never commit real values.

# ── Llama (required for a complete Project 4 submission) ──
# Default provider: Cloudflare Workers AI (free daily allocation of 10,000 Neurons).
# Create an API token with the "Workers AI" permission at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: switch to OpenRouter (or any OpenAI-compatible host that serves Llama).
# LLAMA_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLAMA_BASE_URL=https://openrouter.ai/api/v1

# Optional: override the model. Defaults:
#   cloudflare -> @cf/meta/llama-4-scout-17b-16e-instruct
#   openrouter -> meta-llama/llama-4-scout
# LLAMA_MODEL=

# ── Weather (no key needed) ──
# Optional: point at a self-hosted Open-Meteo instance instead of the free public API.
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_AIR_URL=https://air-quality-api.open-meteo.com/v1/air-quality
